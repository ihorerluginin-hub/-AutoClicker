# Локальные настройки: путь до SDK и пароли от ключа подписи.
# Этот файл у каждого свой, в репозитории ему не место.
local.properties

# Ключ подписи. В публичный репозиторий его коммитить нельзя:
# перегенерация ключа ломает обновление поверх уже установленного APK.
release.keystore
*.keystore
*.jks

